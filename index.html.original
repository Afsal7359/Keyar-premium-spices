<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Aurum Spice House – Whole spices, graded and sealed</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&family=Roboto+Serif:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Roboto+Condensed:wght@400;500;600&display=swap">
<style>
:root{--bg:#09150e;--bg2:#0f2016;--moss:#5f7c3a;--moss-d:#3f5a27;--gold:#d2a93a;--gold-l:#ecd48a;--ivory:#f3ecd9;--mute:#a9b59f;--line:rgba(236,212,138,.18);
--serif:"Roboto Serif",Georgia,"Times New Roman",serif;--sans:"Roboto",system-ui,-apple-system,"Segoe UI",sans-serif;--cond:"Roboto Condensed","Roboto",system-ui,sans-serif;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:dark}
html{scroll-behavior:smooth;scroll-padding-top:80px}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ivory);font-family:var(--sans);font-weight:300;line-height:1.7;overflow-x:hidden}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:60}
nav{position:fixed;top:env(safe-area-inset-top,0px);left:0;right:0;z-index:50;display:flex;justify-content:space-between;align-items:center;padding:18px 5vw;transition:background .4s,padding .4s}
nav.s{background:rgba(9,21,14,.88);backdrop-filter:blur(12px);padding-top:12px;padding-bottom:12px;border-bottom:1px solid var(--line)}
.logo{font-family:var(--serif);font-size:1.3rem;font-weight:500;letter-spacing:-.01em;display:flex;gap:10px;align-items:center}
.logo i{width:12px;height:12px;border-radius:50% 0 50% 0;background:var(--gold);display:block;transform:rotate(45deg)}
.links{display:flex;gap:30px;align-items:center;font-size:.9rem}
.links a:hover{color:var(--gold-l)}
.mb{display:none;width:44px;height:44px;border:1px solid var(--line);border-radius:50%;background:transparent;flex-direction:column;justify-content:center;align-items:center;gap:6px;cursor:pointer;padding:0}
.mb span{width:18px;height:1.5px;background:var(--ivory);transition:transform .3s}
.mb[aria-expanded=true] span:first-child{transform:translateY(3.8px) rotate(45deg)}
.mb[aria-expanded=true] span:last-child{transform:translateY(-3.8px) rotate(-45deg)}
.btn{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--gold);background:var(--gold);color:#1b1503;padding:13px 26px;border-radius:40px;font:500 .95rem var(--sans);cursor:pointer;transition:transform .3s,background .3s,color .3s}
.btn:hover{transform:translateY(-2px);background:var(--gold-l)}
.btn.o{background:transparent;color:var(--ivory);border-color:var(--line)}
.btn.o:hover{border-color:var(--gold);color:var(--gold-l);background:transparent}
.h1,.h2{font-family:var(--serif);font-weight:400;line-height:1.1;margin:0}
.h1{font-size:clamp(2.3rem,6.6vw,5.8rem);letter-spacing:-.025em}
.h2{font-size:clamp(1.9rem,4.2vw,3.5rem);letter-spacing:-.02em}
em{font-style:italic;color:var(--gold-l)}
/* hero */
.hero{position:relative;min-height:100vh;display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:3vw;padding:120px 5vw 70px;overflow:hidden;background:radial-gradient(ellipse at 75% 40%,#17331f 0,var(--bg) 62%)}
.hero p{max-width:46ch;color:var(--mute);font-size:1.05rem;margin:26px 0 34px}
.hero .row{display:flex;gap:14px;flex-wrap:wrap}
.hl{display:block;overflow:hidden}
.hl span{display:block;transform:translateY(105%);animation:up 1.2s cubic-bezier(.2,.8,.2,1) forwards}
.hl:nth-child(2) span{animation-delay:.15s}.hl:nth-child(3) span{animation-delay:.3s}
@keyframes up{to{transform:none}}
.orb{position:relative;aspect-ratio:1;width:min(100%,560px);justify-self:center}
.orb .ring{position:absolute;inset:-4%;border-radius:50%;border:1px dashed var(--gold);opacity:.5;animation:spin 60s linear infinite}
.orb .disc{position:absolute;inset:6%;border-radius:50%;overflow:hidden;border:6px solid var(--moss-d);box-shadow:0 40px 90px rgba(0,0,0,.6),0 0 0 1px var(--line)}
.orb .disc img{width:100%;height:100%;object-fit:cover;transform:scale(1.12)}
.orb .tag{position:absolute;background:var(--ivory);color:#16200f;border-radius:16px;padding:10px 16px;font-size:.82rem;font-weight:500;box-shadow:0 14px 34px rgba(0,0,0,.45)}
.orb .t1{left:-4%;bottom:14%}.orb .t2{right:-2%;top:12%}
@keyframes spin{to{transform:rotate(360deg)}}
.cue{position:absolute;left:5vw;bottom:26px;font-size:.8rem;color:var(--mute);display:flex;gap:12px;align-items:center}
.cue b{width:1px;height:42px;background:linear-gradient(var(--gold),transparent);display:block;animation:drip 2s ease-in-out infinite}
@keyframes drip{50%{transform:scaleY(.4);transform-origin:top}}
/* marquee */
.mq{border-block:1px solid var(--line);overflow:hidden;white-space:nowrap;padding:22px 0;background:var(--bg2)}
.mq div{display:inline-flex;gap:56px;padding-right:56px;font-family:var(--serif);font-size:1.7rem;font-style:italic;color:var(--gold-l);animation:mq 38s linear infinite}
.mq div span::after{content:"";display:inline-block;width:8px;height:8px;margin-left:56px;background:var(--moss);border-radius:50% 0;transform:rotate(45deg)}
@keyframes mq{to{transform:translateX(-100%)}}
/* pinned showcase */
.pin{height:480vh;position:relative}
.stage{position:sticky;top:0;height:100vh;height:100svh;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:4vw;padding:90px 5vw 40px;background:linear-gradient(120deg,var(--bg),#10281a)}
.copy{position:relative;min-height:340px}
.slide{position:absolute;inset:0;opacity:0;transform:translateY(40px);transition:opacity .7s,transform .7s;pointer-events:none}
.slide.on{opacity:1;transform:none;pointer-events:auto}
.slide p{color:var(--mute);max-width:44ch;margin:20px 0}
.notes{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:24px}
.notes span{font-family:var(--cond);border:1px solid var(--line);border-radius:30px;padding:5px 15px;font-size:.92rem;color:var(--gold-l)}
.big{position:relative;aspect-ratio:1;width:min(100%,min(62vh,540px));justify-self:center}
.big .ring{position:absolute;inset:-5%;border-radius:50%;border:1px solid var(--gold);opacity:.45}
.big .ring::after{content:"";position:absolute;top:-6px;left:50%;width:12px;height:12px;border-radius:50%;background:var(--gold);box-shadow:0 0 22px var(--gold)}
.big .mask{position:absolute;inset:0;border-radius:50%;overflow:hidden;border:6px solid var(--moss-d);box-shadow:0 40px 90px rgba(0,0,0,.6)}
.big img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transform:scale(1.25);transition:opacity .8s,transform 1.4s cubic-bezier(.2,.8,.2,1)}
.big img.on{opacity:1;transform:scale(1.05)}
.prog{position:absolute;left:5vw;right:5vw;bottom:26px;height:2px;background:var(--line)}
.prog i{display:block;height:100%;width:0;background:var(--gold)}
/* sections */
section.pad{padding:130px 5vw}
.head{display:flex;justify-content:space-between;align-items:end;gap:30px;flex-wrap:wrap;margin-bottom:60px}
.head p{max-width:42ch;color:var(--mute);margin:0}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}
.card{background:linear-gradient(180deg,#12281a,#0d1d13);border:1px solid var(--line);border-radius:26px 26px 26px 100px;padding:14px 14px 26px;transition:transform .5s,border-color .4s}
.card:hover{transform:translateY(-8px);border-color:var(--gold)}
.card .ph{aspect-ratio:1;border-radius:18px 18px 18px 86px;overflow:hidden}
.card .ph img{width:100%;height:100%;object-fit:cover;transition:transform 1s}
.card:hover .ph img{transform:scale(1.08)}
.card h3{font:500 1.5rem/1.15 var(--serif);margin:20px 10px 4px}
.card small{display:block;margin:0 10px 14px;color:var(--mute)}
.chips{display:flex;flex-wrap:wrap;gap:7px;margin:0 10px 18px}
.chips button{font:500 .88rem var(--cond);letter-spacing:.02em;color:var(--ivory);background:transparent;border:1px solid var(--line);border-radius:30px;padding:6px 13px;cursor:pointer;transition:.25s}
.chips button:hover{border-color:var(--gold)}
.chips button[aria-pressed=true]{background:var(--gold);color:#1b1503;border-color:var(--gold)}
.card .btn{margin:0 10px;width:calc(100% - 20px);justify-content:center;padding:11px}
/* story */
.story{background:var(--moss);color:#f6f1dd;position:relative;overflow:hidden}
.story .h2 em{color:#fff3bf}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:6vw;align-items:center}
.steps{display:grid;gap:0}
.step{padding:26px 0;border-top:1px solid rgba(255,255,255,.25)}
.step h4{font:500 1.4rem var(--serif);margin:0 0 4px}
.step p{margin:0;opacity:.85;max-width:46ch}
.story .mini{margin-top:40px;display:flex;gap:16px}
.story .mini div{width:130px;aspect-ratio:1;border-radius:50%;overflow:hidden;border:4px solid var(--moss-d)}
.story .mini img{width:100%;height:100%;object-fit:cover}
/* enquiry */
.enq{display:grid;grid-template-columns:1fr 1fr;gap:5vw;align-items:start}
.list{border:1px solid var(--line);border-radius:26px;padding:30px;background:var(--bg2);min-height:260px}
.list ul{list-style:none;margin:0 0 22px;padding:0}
.list li{display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}
.list li button{background:none;border:0;color:var(--mute);cursor:pointer;font:inherit}
.list li button:hover{color:var(--gold-l)}
.list .empty{color:var(--mute)}
footer{border-top:1px solid var(--line);padding:40px 5vw;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;color:var(--mute);font-size:.9rem}
.rv{opacity:0;transform:translateY(46px);transition:opacity .9s,transform .9s cubic-bezier(.2,.8,.2,1)}
.rv.in{opacity:1;transform:none}
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translate(-50%,30px);background:var(--ivory);color:#16200f;padding:12px 22px;border-radius:30px;font-weight:500;opacity:0;transition:.4s;z-index:70;pointer-events:none}
.toast.on{opacity:1;transform:translate(-50%,0)}
@media(max-width:900px){
.mb{display:flex}nav.s{backdrop-filter:none;background:var(--bg)}.links{position:fixed;inset:0;flex-direction:column;justify-content:center;gap:28px;background:var(--bg);font-size:1.5rem;transform:translateY(-100%);transition:transform .5s;z-index:-1;visibility:hidden}.links.open{transform:none;visibility:visible}.links .btn{font-size:1rem}
.hero{grid-template-columns:1fr;padding-top:110px;text-align:left}.orb{width:80%;order:-1;margin-bottom:10px}.cue{display:none}
.stage{grid-template-columns:1fr;grid-template-rows:auto 1fr;padding-top:80px;gap:20px}.big{width:min(62vw,36vh);order:-1}.copy{min-height:300px}
.grid{grid-template-columns:1fr 1fr}.cols,.enq{grid-template-columns:1fr}section.pad{padding:90px 5vw}}
@media(max-width:520px){.grid{grid-template-columns:1fr}.hero{padding:96px 6vw 56px}.orb{width:86%}.orb .t1{left:0;bottom:4%}.orb .t2{right:0;top:2%}.orb .tag{font-size:.72rem;padding:8px 12px}.hero p{font-size:.98rem;margin:20px 0 26px}.hero .btn{width:100%;justify-content:center}.mq div{font-size:1.25rem;gap:34px}.mq div span::after{margin-left:34px}.big{width:min(68vw,32vh)}.slide p{font-size:.95rem;margin:14px 0}.copy{min-height:330px}.list{padding:20px}.chips button{padding:8px 14px}.head{margin-bottom:34px}section.pad{padding:72px 6vw}footer{flex-direction:column;padding:32px 6vw}.story .mini div{width:92px}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.hl span{transform:none}.rv{opacity:1;transform:none}html{scroll-behavior:auto}}
</style>
</head>
<body>
<nav id="nav"><a class="logo" href="#top"><i></i>Aurum Spice House</a>
<button class="mb" id="mb" type="button" aria-label="Menu" aria-expanded="false"><span></span><span></span></button><div class="links" id="links"><a href="#collection">Collection</a><a href="#story">Our process</a><a href="#enquire">Enquire</a><a class="btn" href="#collection">Shop spices</a></div></nav>

<header class="hero" id="top">
<div>
<h1 class="h1"><span class="hl"><span>Whole spices,</span></span><span class="hl"><span>picked at their</span></span><span class="hl"><span><em>golden hour.</em></span></span></h1>
<p>Green cardamom, black pepper, clove and nutmeg flower. Graded by hand, sealed fresh and packed from 50 g to 1 kg.</p>
<div class="row"><a class="btn" href="#collection">Explore the collection</a><a class="btn o" href="#spice">See how they differ</a></div>
</div>
<div class="orb" id="orb"><div class="ring"></div><div class="disc"><img data-img="pepper" alt="Black peppercorns in a wooden bowl with fresh pepper vines"></div>
<div class="tag t1">Sizes 50 g to 1 kg</div><div class="tag t2">Hand-graded, sealed fresh</div></div>
<div class="cue"><b></b>Scroll to explore</div>
</header>

<div class="mq" aria-hidden="true"><div><span>Green Cardamom</span><span>Black Pepper</span><span>Clove</span><span>Nutmeg Flower</span></div><div><span>Green Cardamom</span><span>Black Pepper</span><span>Clove</span><span>Nutmeg Flower</span></div></div>

<div class="pin" id="spice"><div class="stage">
<div class="copy">
<div class="slide on"><h2 class="h2">Green Cardamom</h2><p>Plump, fragrant pods with tiny black seeds. Crack one open and the aroma fills the room.</p><div class="notes"><span>Citrus</span><span>Eucalyptus</span><span>Sweet</span></div><a class="btn o" href="#collection">Choose a size</a></div>
<div class="slide"><h2 class="h2">Black Pepper</h2><p>Dense, wrinkled berries with a sharp heat and a piney finish. Best ground fresh over the plate.</p><div class="notes"><span>Pungent</span><span>Woody</span><span>Bright</span></div><a class="btn o" href="#collection">Choose a size</a></div>
<div class="slide"><h2 class="h2">Clove</h2><p>Dried flower buds with a deep, warm intensity. A little goes a long way in rice, tea and slow braises.</p><div class="notes"><span>Warm</span><span>Sweet</span><span>Intense</span></div><a class="btn o" href="#collection">Choose a size</a></div>
<div class="slide"><h2 class="h2">Nutmeg Flower</h2><p>The crimson lace that wraps the nutmeg seed. Softer than nutmeg, with a floral warmth for desserts and curries.</p><div class="notes"><span>Floral</span><span>Warm</span><span>Delicate</span></div><a class="btn o" href="#collection">Choose a size</a></div>
</div>
<div class="big" id="big"><div class="ring" id="bring"></div><div class="mask">
<img class="on" data-img="cardamom" alt="Green cardamom pods in a wooden bowl"><img data-img="pepper" alt="Black pepper"><img data-img="clove" alt="Whole cloves with clove flowers"><img data-img="mace" alt="Nutmeg flower (mace) with whole nutmeg"></div></div>
<div class="prog"><i id="pbar"></i></div>
</div></div>

<section class="pad" id="collection">
<div class="head rv"><h2 class="h2">The collection</h2><p>Pick a pack size on each spice, add it to your enquiry list and send it to us in one go.</p></div>
<div class="grid" id="grid"></div>
</section>

<section class="pad story" id="story"><div class="cols">
<div class="rv"><h2 class="h2">From the vine to <em>your kitchen</em></h2>
<div class="mini"><div><img data-img="cardamom" alt=""></div><div><img data-img="clove" alt=""></div><div><img data-img="mace" alt=""></div></div></div>
<div class="steps">
<div class="step rv"><h4>Picked ripe</h4><p>Pods, berries and buds are harvested when their oils are at their strongest.</p></div>
<div class="step rv"><h4>Dried slowly</h4><p>Gentle drying locks in colour and aroma without scorching the spice.</p></div>
<div class="step rv"><h4>Graded by hand</h4><p>Every batch is sorted for size, colour and cleanliness before packing.</p></div>
<div class="step rv"><h4>Sealed fresh</h4><p>Packed in 50 g, 100 g, 250 g, 500 g and 1 kg bags to protect flavour.</p></div>
</div></div></section>

<section class="pad" id="enquire"><div class="enq">
<div class="rv"><h2 class="h2">Send us your <em>enquiry list</em></h2><p style="color:var(--mute);max-width:42ch;margin-top:20px">Add spices and sizes from the collection. Copy the list and send it to us to get pricing and delivery details.</p></div>
<div class="list rv"><ul id="ul"></ul><button class="btn" id="copy">Copy enquiry list</button></div>
</div></section>

<footer><span>© 2026 Aurum Spice House</span><span>Green Cardamom · Black Pepper · Clove · Nutmeg Flower</span></footer>
<div class="toast" id="toast" role="status"></div>

<script>
const IMG={"cardamom": "data:image/jpeg;base64,", "pepper": "data:image/jpeg;base64,", "clove": "data:image/jpeg;base64,", "mace": "data:image/jpeg;base64,"};
document.querySelectorAll('[data-img]').forEach(i=>i.src=IMG[i.dataset.img]);
const P=[{n:'Green Cardamom',k:'cardamom',d:'Aromatic whole pods'},{n:'Black Pepper',k:'pepper',d:'Bold whole peppercorns'},{n:'Clove',k:'clove',d:'Whole dried buds'},{n:'Nutmeg Flower',k:'mace',d:'Whole mace blades'}];
const S=['50g','100g','250g','500g','1kg'];
const sel={},list=[];
const grid=document.getElementById('grid');
P.forEach((p,i)=>{sel[i]='100g';const c=document.createElement('article');c.className='card rv';
c.innerHTML=`<div class="ph"><img src="${IMG[p.k]}" alt="${p.n}"></div><h3>${p.n}</h3><small>${p.d}</small><div class="chips" role="group" aria-label="${p.n} pack size">${S.map(s=>`<button type="button" aria-pressed="${s=='100g'}" data-s="${s}">${s.replace('g',' g').replace('kg',' kg').replace('1 kg ','1 kg')}</button>`).join('')}</div><button class="btn" type="button">Add to enquiry</button>`;
c.querySelectorAll('.chips button').forEach(b=>b.onclick=()=>{c.querySelectorAll('.chips button').forEach(x=>x.setAttribute('aria-pressed',x==b));sel[i]=b.dataset.s});
c.querySelector('.btn').onclick=()=>{const e=list.find(x=>x.i==i&&x.s==sel[i]);if(e)e.q++;else list.push({i,s:sel[i],q:1});draw();toast(p.n+' '+fmt(sel[i])+' added')};
grid.appendChild(c)});
const fmt=s=>s.replace('kg',' kg').replace(/(\d)g$/,'$1 g');
function draw(){const ul=document.getElementById('ul');ul.innerHTML=list.length?'':'<li class="empty">Your list is empty. Add a spice from the collection.</li>';
list.forEach((x,k)=>{const li=document.createElement('li');li.innerHTML=`<span>${P[x.i].n} · ${fmt(x.s)} × ${x.q}</span><button type="button" aria-label="Remove">Remove</button>`;li.querySelector('button').onclick=()=>{list.splice(k,1);draw()};ul.appendChild(li)})}
draw();
function toast(t){const e=document.getElementById('toast');e.textContent=t;e.classList.add('on');clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.remove('on'),1800)}
document.getElementById('copy').onclick=async()=>{if(!list.length){toast('Add a spice first');return}
const t='Enquiry – Aurum Spice House\n'+list.map(x=>`${P[x.i].n}: ${fmt(x.s)} × ${x.q}`).join('\n');
try{await navigator.clipboard.writeText(t);toast('Enquiry list copied')}catch(e){toast('Copy not available here')}};
const mb=document.getElementById('mb'),lk=document.getElementById('links');
function closeM(){lk.classList.remove('open');mb.setAttribute('aria-expanded','false');document.body.style.overflow=''}
mb.onclick=()=>{const o=lk.classList.toggle('open');mb.setAttribute('aria-expanded',o);document.body.style.overflow=o?'hidden':''};
lk.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeM));
addEventListener('resize',()=>{if(innerWidth>900)closeM()});
/* scroll */
const nav=document.getElementById('nav'),orb=document.getElementById('orb'),pin=document.getElementById('spice'),pbar=document.getElementById('pbar'),bring=document.getElementById('bring');
const slides=[...document.querySelectorAll('.slide')],imgs=[...document.querySelectorAll('#big img')];let cur=0;
function tick(){const y=scrollY;nav.classList.toggle('s',y>40);
if(y<innerHeight*1.2)orb.style.transform=`translateY(${y*.12}px) rotate(${y*.02}deg)`;
const r=pin.getBoundingClientRect(),p=Math.max(0,Math.min(1,-r.top/(r.height-innerHeight)));
pbar.style.width=p*100+'%';bring.style.transform=`rotate(${p*360}deg)`;
const n=Math.min(3,Math.floor(p*4));if(n!=cur){cur=n;slides.forEach((s,i)=>s.classList.toggle('on',i==n));imgs.forEach((s,i)=>s.classList.toggle('on',i==n))}}
addEventListener('scroll',()=>requestAnimationFrame(tick),{passive:true});tick();
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.15});
document.querySelectorAll('.rv').forEach((e,i)=>{e.style.transitionDelay=(e.classList.contains('card')?(i%4)*90:0)+'ms';io.observe(e)});
</script>
</body>
</html>
